# Razorpay test/sandbox Key ID (publishable — safe in the client).
# Get one from https://dashboard.razorpay.com → Test Mode → Settings → API Keys.
# Leave this unset to use the built-in mock payment gateway instead.
#
# Copy this file to `.env.local` and fill in your key:
#   cp .env.example .env.local
VITE_RAZORPAY_KEY_ID=
